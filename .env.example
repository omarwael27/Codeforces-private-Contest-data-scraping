# Google Sheets Configuration
# Paste the full Google Sheet link (or a bare spreadsheet ID)
GOOGLE_SHEET_LINK=https://docs.google.com/spreadsheets/d/your_spreadsheet_id/edit
# Comma-separated sheet/tab names
SHEET_NAMES=Sat 4 -> 8,Sun 10 -> 2,Sun 4 -> 8,Mon 4 -> 8

# Per-sheet thresholds (semicolon-separated sheet=threshold).
# "Yes" is written when weighted score >= threshold; otherwise "No".
# Sheets not listed here fall back to GLOBAL_THRESHOLD.
SHEET_THRESHOLDS=Sat 4 -> 8=8;Sun 10 -> 2=10;Sun 4 -> 8=8;Mon 4 -> 8=8
GLOBAL_THRESHOLD=8

# Contests: semicolon-separated name|standings_url|weight|participation_bonus
# Solving m problems in a contest gives m * weight points.
# The optional 4th field is added to official participants who appeared in the
# live standings, but not out-of-competition/virtual/practice participants.
CONTEST_COUNT=2
CONTESTS=Contest1|https://codeforces.com/group/3MTZPM7hsC/contest/651191/standings|1|0;Contest2|https://codeforces.com/group/3MTZPM7hsC/contest/652764/standings|2|2

# Google Auth Files
TOKEN_FILE=token.pickle
CREDENTIALS_FILE=credentials.json

# Scraper Settings
RUN_SCRAPER=True
# Count unofficial/practice-mode participants from the standings
INCLUDE_UNOFFICIAL=True
# Optional: force a Chrome major version (e.g. 154). Leave unset to auto-detect.
# CHROME_VERSION=154
# Persistent Chrome profile for keeping the Codeforces login session
CHROME_PROFILE_DIR=chrome_profile
# Seconds to wait for manual Codeforces login in login.py
LOGIN_TIMEOUT=300
# Seconds to wait for a Cloudflare challenge to clear
CLOUDFLARE_WAIT=30

# Output Files
COMBINED_CSV=combined_results.csv
